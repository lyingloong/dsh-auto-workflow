{
  "name": "dsh-auto-workflow",
  "version": "1.1.0",
  "private": false,
  "description": "dsh-auto-workflow: persistent, concurrent node-graph workflows for DeepSeek Harness: agent, command, HTTP, human, fan-out/join, gate and subworkflow nodes with ordered model fallback, permissions, artifacts and a live board.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./src/plugin.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "src",
    "lib",
    "docs",
    "scripts/verify-release.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run.mjs",
    "test:runner": "node --test tests/run.mjs",
    "test:watch": "node --test --watch tests/run.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "main": "./src/plugin.mjs",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "node-graph",
    "auto-workflow",
    "subagents"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyingloong/dsh-auto-workflow.git"
  },
  "homepage": "https://github.com/lyingloong/dsh-auto-workflow#readme",
  "bugs": {
    "url": "https://github.com/lyingloong/dsh-auto-workflow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
